{
  "mcpServers": {
    "personal-finance": {
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "/path/to/personal-finance/services/mcp-server",
      "env": {
        "PYTHONPATH": "/path/to/personal-finance/services/mcp-server",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
