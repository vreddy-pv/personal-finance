# PyInstaller
#  Usually these files are written by a PyInstaller script
#  in a top-level directory.  Adding them here allows IDEs
#  to configure PyInstaller output paths to be within the
#  project directory.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

