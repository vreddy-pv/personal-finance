# ============================================
# PERSONAL FINANCE APPLICATION - ENVIRONMENT
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to git!

# ============================================
# SPRING BOOT BACKEND CONFIGURATION
# ============================================
SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb
SPRING_DATASOURCE_DRIVERCLASSNAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
SPRING_H2_CONSOLE_ENABLED=true

# ============================================
# LOGIN SERVICE CONFIGURATION (Python/FastAPI)
# ============================================
# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Service Configuration
LOGIN_SERVICE_HOST=0.0.0.0
LOGIN_SERVICE_PORT=8001
DEBUG=False

# ============================================
# MCP SERVER CONFIGURATION (Python/FastAPI)
# ============================================
# Required: Claude API Key
ANTHROPIC_API_KEY=sk-ant-[your-api-key-here]

# Backend Integration
BACKEND_API_URL=http://localhost:8080
BACKEND_API_TIMEOUT=30

# Login Service Integration
LOGIN_SERVICE_URL=http://localhost:8001
LOGIN_SERVICE_TIMEOUT=30

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
DEBUG=False

# ============================================
# ANGULAR FRONTEND CONFIGURATION
# ============================================
# API Base URL
API_BASE_URL=http://localhost:8080

# Login Service URL
LOGIN_SERVICE_URL=http://localhost:8001

# MCP Server URL
MCP_BASE_URL=http://localhost:8082

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4200

# ============================================
# DOCKER & DEPLOYMENT CONFIGURATION
# ============================================
# Docker
COMPOSE_PROJECT_NAME=personal-finance
ENVIRONMENT=development

# Java
JAVA_HOME=/path/to/java17
MAVEN_OPTS=-Xmx1024m

# Python
PYTHONUNBUFFERED=1

# ============================================
# LOGGING & DEBUGGING
# ============================================
LOG_LEVEL=INFO
DEBUG=False

# ============================================
# NOTES
# ============================================
# For development:
#   - Keep H2 in-memory (resets on restart)
#   - Use http:// URLs for local development
#   - DEBUG can be True for troubleshooting

# For production:
#   - Use persistent database
#   - Use https:// URLs
#   - DEBUG must be False
#   - Rotate SECRET_KEY periodically
#   - Use environment-specific .env files
